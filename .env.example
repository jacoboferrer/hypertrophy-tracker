# Copy to .env.local and fill in. .env.local is git-ignored.
VITE_SHEETS_ID=your_sheet_id_here
VITE_SHEETS_API_KEY=your_api_key_here
VITE_SHEETS_TAB=Respuestas de formulario 1

# Origin the test scripts declare as Referer (must match the key's restrictions)
TEST_REFERER=http://localhost:5173/

# Apps Script write endpoint (apps-script/Code.gs). Empty = app stays read-only.
VITE_SYNC_URL=
VITE_SYNC_TOKEN=
